rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in user can read (needed for payment request lookup),
    // but can only write their own document.
    match /users/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email.lower() == email;
    }

    // Plans: only the owning user can read or write.
    match /plans/{planId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email.lower() == resource.data.userEmail;
      allow create: if request.auth != null
                    && request.auth.token.email.lower() == request.resource.data.userEmail;
    }

    // Transactions: only the owning user can read or write.
    match /transactions/{txId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email.lower() == resource.data.userEmail;
      allow create: if request.auth != null
                    && request.auth.token.email.lower() == request.resource.data.userEmail;
    }

    // Requests: sender or recipient can read; only sender can create;
    // only recipient can update (to respond).
    match /requests/{reqId} {
      allow read: if request.auth != null
                  && (request.auth.token.email.lower() == resource.data.requesterEmail.lower()
                   || request.auth.token.email.lower() == resource.data.recipientEmail.lower());
      allow create: if request.auth != null
                    && request.auth.token.email.lower() == request.resource.data.requesterEmail.lower();
      allow update: if request.auth != null
                    && request.auth.token.email.lower() == resource.data.recipientEmail.lower();
      allow delete: if false;
    }

  }
}
